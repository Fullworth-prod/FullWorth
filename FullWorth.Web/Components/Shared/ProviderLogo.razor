@using FullWorth.Web.Services

@{
    var logoUrl = ProviderLogoResolver.Resolve(ProviderName);
}

@if (!string.IsNullOrWhiteSpace(logoUrl) && logoUrl != _failedUrl)
{
    <img src="@logoUrl"
         alt=""
         aria-hidden="true"
         referrerpolicy="no-referrer"
         decoding="async"
         class="provider-logo-image"
         @onerror="() => MarkUnavailable(logoUrl)" />
}
else if (FallbackContent is not null)
{
    @FallbackContent
}
else
{
    @GetInitial(ProviderName)
}

@code {
    private string? _failedUrl;

    private void MarkUnavailable(string? url) => _failedUrl = url;

    [Parameter]
    public string? ProviderName { get; set; }

    [Parameter]
    public RenderFragment? FallbackContent { get; set; }

    private static string GetInitial(string? providerName)
    {
        if (string.IsNullOrWhiteSpace(providerName))
        {
            return "?";
        }

        return char.ToUpperInvariant(providerName.Trim()[0]).ToString();
    }
}
