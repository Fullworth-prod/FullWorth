@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject Microsoft.Extensions.Localization.IStringLocalizer<FullWorth.Web.Components.App> L

<button class="theme-toggle"
        type="button"
        disabled="@(_themeModule is null)"
        @onclick="ToggleThemeAsync"
        aria-label="@ButtonLabel"
        title="@ButtonLabel">

    <svg class="theme-icon bw-sprite"
         aria-hidden="true">
        <use href="@ThemeSpriteHref"></use>
    </svg>
</button>

@code {
    private IJSObjectReference? _themeModule;
    private bool _isDark = true;

    private string ButtonLabel =>
        _isDark
            ? L["Switch to light mode"].Value
            : L["Switch to dark mode"].Value;

    private string ThemeSpriteHref =>
        _isDark
            ? "/assets/billwatch-sprites.svg#sun"
            : "/assets/billwatch-sprites.svg#moon";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _themeModule =
            await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/theme.js");

        _isDark =
            await _themeModule.InvokeAsync<bool>(
                "initializeTheme");

        StateHasChanged();
    }

    private async Task ToggleThemeAsync()
    {
        if (_themeModule is null)
        {
            return;
        }

        _isDark =
            await _themeModule.InvokeAsync<bool>(
                "toggleTheme");
    }
}