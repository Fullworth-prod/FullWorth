@page "/app/setup"

@using FullWorth.Web.Services

@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@layout AppLayout
@implements IAsyncDisposable

@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<ExperienceSetup> L

<PageTitle>@L["Set up FullWorth"]</PageTitle>
<link rel="stylesheet" href="/account-settings.css" />

<div class="app-page settings-page experience-setup-page" aria-busy="@(_isLoading || _isSaving || _isChecking)">
    <header class="settings-header">
        <div>
            <span class="page-kicker">@L["Personal setup"]</span>
            <h1>@(IsSettingsEdit
                ? L["Personalize FullWorth"]
                : L["Set up FullWorth for you"])</h1>
            <p>@(IsSettingsEdit
                ? L["Update how FullWorth looks, reads, and prioritizes your financial information."]
                : L["Choose how FullWorth should look, read, and prioritize your financial information. You can change these preferences later."])</p>
        </div>
    </header>
    @if (IsSettingsEdit && _hasLoaded && !IsLocked)
    {
        <a class="secondary-action setup-exit" href="/app/account/settings">@L["Leave without saving"]</a>
    }

    @if (_isLoading)
    {
        <section class="onboarding-card" aria-busy="true">
            <div class="onboarding-copy">
                <span class="page-kicker">@L["Getting things ready"]</span>
                <h2>@L["Loading your preferences…"]</h2>
                <p>@L["FullWorth is preparing your one-time setup."]</p>
            </div>
        </section>
    }
    else if (!_hasLoaded)
    {
        <section class="onboarding-card setup-load-error">
            <div class="onboarding-copy">
                <h2>@L["Your saved setup is unavailable"]</h2>
                <p role="alert">@L["We could not load a valid saved setup. Retry before editing so defaults do not overwrite your preferences."]</p>
                <button type="button" class="primary-action" @onclick="LoadAsync">@L["Retry loading setup"]</button>
                @if (IsSettingsEdit)
                {
                    <a class="secondary-action" href="/app/account/settings">@L["Back to settings"]</a>
                }
            </div>
        </section>
    }
    else
    {
        <section class="onboarding-card">
            <div class="onboarding-copy">
                <span class="page-kicker">@GetStepKicker()</span>
                <h2 tabindex="-1" @ref="_stepHeading" id="setup-step-heading">@GetStepTitle()</h2>
                <p>@GetStepDescription()</p>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="settings-toast settings-toast-error" role="alert">
                        <div class="settings-toast-icon" aria-hidden="true">!</div>
                        <div class="settings-toast-copy">
                            <strong>@L["Something needs your attention"]</strong>
                            <span>@_error</span>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_notice))
                {
                    <p class="setup-notice" role="status">@_notice</p>
                }
                @if (_saveUncertain)
                {
                    <div class="setup-recovery">
                        <p>@L["Your edits are kept. This check only reads saved preferences; it does not repeat the save."]</p>
                        <button type="button" class="secondary-action" disabled="@_isChecking" @onclick="CheckSavedAsync">
                            @(_isChecking ? L["Checking saved setup…"] : L["Check saved setup"])
                        </button>
                    </div>
                }
                @if (_saveConfirmed)
                {
                    <p role="status">@L["Your personal setup was saved."]</p>
                    <button type="button" class="primary-action" @onclick="ContinueAfterSave">@L["Continue to FullWorth"]</button>
                }
                <fieldset class="setup-fields" disabled="@IsLocked" aria-labelledby="setup-step-heading">
                @if (_step == 1)
                {
                    <div class="settings-card-grid">
                        <section class="settings-card">
                            <div class="settings-copy">
                                <h2>@L["Language"]</h2>
                                <p>@L["Choose the language FullWorth should use for interface text."]</p>
                            </div>

                            <label class="settings-field">
                                <span id="setup-language-label">@L["Interface language"]</span>
                                <select aria-labelledby="setup-language-label" @bind="_language">
                                    <option value="en-US">English</option>
                                    <option value="es">Español</option>
                                </select>
                            </label>
                        </section>

                        <section class="settings-card">
                            <div class="settings-copy">
                                <h2>@L["Appearance"]</h2>
                                <p>@L["Choose the starting theme for this device."]</p>
                            </div>

                            <label class="settings-field">
                                <span id="setup-theme-label">@L["Theme"]</span>
                                <select aria-labelledby="setup-theme-label" @bind="_theme">
                                    <option value="System">@L["System"]</option>
                                    <option value="Light">@L["Light"]</option>
                                    <option value="Dark">@L["Dark"]</option>
                                </select>
                            </label>
                        </section>
                    </div>
                }
                else if (_step == 2)
                {
                    <div class="settings-card-grid">
                        <section class="settings-card settings-card-wide">
                            <div class="settings-copy">
                                <h2>@L["Readability"]</h2>
                                <p>@L["Pick the text size that is most comfortable for you. FullWorth will scale the interface without changing your financial data."]</p>
                            </div>

                            <label class="settings-field">
                                <span id="setup-text-size-label">@L["Text size"]</span>
                                <select aria-labelledby="setup-text-size-label" @bind="_textSize">
                                    <option value="Standard">@L["Standard"]</option>
                                    <option value="Large">@L["Large"]</option>
                                    <option value="ExtraLarge">@L["Extra large"]</option>
                                </select>
                            </label>

                            <label class="remember-option">
                                <input type="checkbox" @bind="_highContrast" />
                                <span>@L["Use stronger text and border contrast"]</span>
                            </label>

                            <label class="remember-option">
                                <input type="checkbox" @bind="_reduceMotion" />
                                <span>@L["Reduce animations and motion"]</span>
                            </label>
                        </section>
                    </div>
                }
                else if (_step == 3)
                {
                    <div class="settings-card-grid">
                        <section class="settings-card settings-card-wide">
                            <div class="settings-copy">
                                <h2>@L["What should FullWorth emphasize?"]</h2>
                                <p>@L["Choose everything that matters to you. These choices guide emphasis and ordering; they do not remove features."]</p>
                            </div>

                            <div class="settings-grid two-column">
                                @foreach (var option in FocusOptions)
                                {
                                    <label class="remember-option">
                                        <input type="checkbox"
                                               checked="@_focus.Contains(option.Value)"
                                               @onchange="args => SetFocus(option.Value, args)" />
                                        <span>
                                            <strong>@L[option.Title]</strong><br />
                                            <small>@L[option.Description]</small>
                                        </span>
                                    </label>
                                }
                            </div>
                        </section>
                    </div>
                }

                else
                {
                    <section class="setup-review" aria-label="@L["Review your setup"]">
                        <dl>
                            <div><dt>@L["Interface language"]</dt><dd>@(_language == "es" ? "Español" : "English")</dd></div>
                            <div><dt>@L["Theme"]</dt><dd>@L[_theme]</dd></div>
                            <div><dt>@L["Text size"]</dt><dd>@L[_textSize == "ExtraLarge" ? "Extra large" : _textSize]</dd></div>
                            <div><dt>@L["Stronger contrast"]</dt><dd>@L[_highContrast ? "On" : "Off"]</dd></div>
                            <div><dt>@L["Reduced motion"]</dt><dd>@L[_reduceMotion ? "On" : "Off"]</dd></div>
                            <div><dt>@L["Your priorities"]</dt><dd>
                                @foreach (var option in FocusOptions.Where(option => _focus.Contains(option.Value)))
                                {
                                    <span class="setup-focus-summary">@L[option.Title]</span>
                                }
                                @if (_focus.Count == 0) { <span>@L["Choose at least one priority before saving."]</span> }
                            </dd></div>
                        </dl>
                        <p>@L["These choices change presentation only. They do not connect a bank, start monitoring, or change your financial records."]</p>
                    </section>
                }
                <div class="settings-actions">
                    @if (_step > 1)
                    {
                        <button type="button"
                                class="secondary-action"
                                disabled="@IsLocked"
                                @onclick="PreviousStep">
                            @L["Back"]
                        </button>
                    }

                    @if (_step < 4)
                    {
                        <button type="button"
                                class="primary-action"
                                disabled="@IsLocked"
                                @onclick="NextStep">
                            @L["Continue"]
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="primary-action"
                                disabled="@IsLocked"
                                @onclick="FinishAsync">
                            @(_isSaving
                                ? L["Saving your setup…"]
                                : L["Save setup"])
                        </button>
                    }
                </div>
                </fieldset>
            </div>

            <nav class="setup-progress" aria-label="@L["Setup progress"]">
                <ol>
                    @foreach (var stage in new[] { 1, 2, 3, 4 })
                    {
                        <li>
                            <button type="button" disabled="@IsLocked"
                                    aria-current="@(stage == _step ? "step" : null)"
                                    @onclick="() => GoToStep(stage)">
                                <span aria-hidden="true">@stage</span>
                                @L[stage switch { 1 => "Language & theme", 2 => "Readability", 3 => "Your priorities", _ => "Review & save" }]
                            </button>
                        </li>
                    }
                </ol>
            </nav>
        </section>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnTo")]
    public string? ReturnTo { get; set; }

    private static readonly FocusOption[] FocusOptions =
    [
        new(
            "BillChanges",
            "Bill changes",
            "Surface meaningful increases and annualized impact."),

        new(
            "Spending",
            "Spending",
            "Make recent transaction activity easier to scan."),

        new(
            "RecurringCosts",
            "Recurring costs",
            "Emphasize subscriptions and repeating charges."),

        new(
            "AccountOverview",
            "Whole financial picture",
            "Keep connected accounts and overall position prominent."),

        new(
            "Statements",
            "Statement explanations",
            "Prioritize evidence explaining why a bill changed.")
    ];

    private IJSObjectReference? _preferencesModule;

    private bool IsSettingsEdit =>
        string.Equals(
            ReturnTo,
            "settings",
            StringComparison.OrdinalIgnoreCase);

    private int _step = 1;
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _error;
    private string _language = "en-US";
    private string _theme = "System";
    private string _textSize = "Standard";
    private bool _highContrast;
    private bool _reduceMotion;

    private readonly HashSet<string> _focus =
        new(
            [
                "BillChanges",
                "AccountOverview"
            ],
            StringComparer.Ordinal);

    private bool _disposed;
    private bool _hasLoaded;
    private bool _readPending;
    private bool _saveUncertain;
    private bool _saveConfirmed;
    private bool _isChecking;
    private bool _focusHeadingPending;
    private string? _notice;
    private long _readVersion;
    private ExperienceSetupValues? _submitted;
    private ElementReference _stepHeading;
    private bool IsLocked => _isLoading || _isSaving || _isChecking || _saveUncertain || _saveConfirmed;

    private ExperienceSetupValues Draft => new(_language, _theme, _textSize, _highContrast,
        _reduceMotion, ExperienceSetupValues.FocusOrder.Where(value => _focus.Contains(value)).ToArray());

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (firstRender)
        {
            await LoadAsync();
            if (!_disposed) StateHasChanged();
        }
        else if (_focusHeadingPending)
        {
            _focusHeadingPending = false;
            try { await _stepHeading.FocusAsync(); }
            catch (JSException) { }
        }
    }

    private async Task<IJSObjectReference> ModuleAsync()
    {
        if (_preferencesModule is not null) return _preferencesModule;
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/local-time.js");
        if (_disposed)
        {
            await module.DisposeAsync();
            throw new ObjectDisposedException(nameof(ExperienceSetup));
        }
        return _preferencesModule = module;
    }

    private async Task LoadAsync()
    {
        if (_disposed || _hasLoaded || _readPending) return;
        _readPending = true;
        var version = ++_readVersion;
        _isLoading = true;
        try
        {
            var module = await ModuleAsync();
            if (_disposed || version != _readVersion) return;
            var response = await module.InvokeAsync<ExperienceSetupResponse>("getExperiencePreferences");
            var values = ExperienceSetupValues.Read(response);
            if (_disposed || version != _readVersion) return;
            ApplyDraft(values);
            _hasLoaded = true;
            _error = null;
        }
        catch (Exception)
        {
            if (!_disposed && version == _readVersion) _hasLoaded = false;
        }
        finally { if (version == _readVersion) { _isLoading = false; _readPending = false; } }
    }

    private void ApplyDraft(ExperienceSetupValues values)
    {
        _language = values.Language;
        _theme = values.Theme;
        _textSize = values.TextSize;
        _highContrast = values.HighContrast;
        _reduceMotion = values.ReduceMotion;
        _focus.Clear();
        foreach (var value in values.Focus) _focus.Add(value);
        if (_focus.Count == 0)
        {
            _focus.Add("BillChanges");
            _focus.Add("AccountOverview");
        }
    }

    private void GoToStep(int step)
    {
        if (_disposed || !_hasLoaded || IsLocked) return;
        _step = Math.Clamp(step, 1, 4);
        _error = null;
        _focusHeadingPending = true;
    }
    private void NextStep() => GoToStep(_step + 1);
    private void PreviousStep() => GoToStep(_step - 1);

    private void SetFocus(string value, ChangeEventArgs args)
    {
        if (_disposed || IsLocked || !ExperienceSetupValues.FocusOrder.Contains(value, StringComparer.Ordinal)) return;
        if (args.Value is true) _focus.Add(value);
        else _focus.Remove(value);
    }

    private async Task FinishAsync()
    {
        if (_disposed || !_hasLoaded || IsLocked || _step != 4) return;
        if (_focus.Count == 0)
        {
            _error = L["Choose at least one area for FullWorth to emphasize."];
            return;
        }
        var submitted = Draft;
        _submitted = submitted;
        _isSaving = true;
        _error = null;
        _notice = null;
        try
        {
            var module = await ModuleAsync();
            if (_disposed) return;
            var response = await module.InvokeAsync<ExperienceSetupResponse>("persistExperiencePreferences", new
            {
                preferredUiLanguage = submitted.Language, themePreference = submitted.Theme,
                textSizePreference = submitted.TextSize, highContrastEnabled = submitted.HighContrast,
                reduceMotionEnabled = submitted.ReduceMotion, experienceFocus = submitted.Focus.ToArray()
            });
            var saved = ExperienceSetupValues.Read(response, requireComplete: true);
            if (_disposed) return;
            if (!submitted.Matches(saved)) throw new InvalidOperationException("Unconfirmed preference result.");
            await ConfirmSaveAsync(module, response);
        }
        catch (Exception)
        {
            if (!_disposed && !_saveConfirmed)
            {
                _saveUncertain = true;
                _error = L["We could not confirm whether setup was saved. Check saved setup before deciding to retry."];
            }
        }
        finally { _isSaving = false; }
    }

    private async Task CheckSavedAsync()
    {
        if (_disposed || !_saveUncertain || _isChecking || _submitted is null) return;
        _isChecking = true;
        try
        {
            var module = await ModuleAsync();
            if (_disposed) return;
            var response = await module.InvokeAsync<ExperienceSetupResponse>("getExperiencePreferences");
            var saved = ExperienceSetupValues.Read(response);
            if (_disposed) return;
            if (response.ExperienceSetupComplete == true && _submitted.Matches(saved))
            {
                await ConfirmSaveAsync(module, response);
            }
            else
            {
                _saveUncertain = false;
                _error = null;
                _notice = L["Saved preferences currently differ from your edits. Your edits are kept; review them before saving again. No save was retried."];
            }
        }
        catch (Exception)
        {
            if (!_disposed)
                _error = L["Saved setup could not be checked. Your edits are kept. Retry the read when the connection is available."];
        }
        finally { _isChecking = false; }
    }

    private async Task ConfirmSaveAsync(IJSObjectReference module, ExperienceSetupResponse response)
    {
        _saveConfirmed = true;
        _saveUncertain = false;
        _error = null;
        try
        {
            var applied = await module.InvokeAsync<bool>("applyExperiencePreferences", response, true);
            if (_disposed) return;
            if (applied) ContinueAfterSave();
            else _notice = L["Your setup was saved. Some browser preferences could not be applied or remembered. Continue to reload FullWorth."];
        }
        catch (Exception)
        {
            if (!_disposed)
                _notice = L["Your setup was saved. Some browser preferences could not be applied or remembered. Continue to reload FullWorth."];
        }
    }

    private void ContinueAfterSave()
    {
        if (_disposed || !_saveConfirmed) return;
        Navigation.NavigateTo(IsSettingsEdit ? "/app/account/settings" : "/app", forceLoad: true);
    }

    private string GetStepKicker() =>
        _step switch
        {
            _ => L["Step {0} of 4", _step]
        };

    private string GetStepTitle() =>
        _step switch
        {
            1 => L["Start with the way you prefer to use FullWorth."],
            2 => L["Make FullWorth comfortable to read."],
            3 => L["Tell FullWorth what matters most."],
            _ => L["Review before you save."]
        };

    private string GetStepDescription() =>
        _step switch
        {
            1 => L["Choose your language and appearance. These are starting preferences, not permanent restrictions."],
            2 => L["Accessibility choices should make the app easier to use without hiding information or changing calculations."],
            3 => L["FullWorth will use these choices to emphasize the right information while keeping every feature available."],
            _ => L["Check your choices. Nothing is saved until you choose Save setup."]
        };

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _readVersion++;
        _submitted = null;
        _focus.Clear();
        if (_preferencesModule is null)
        {
            return;
        }

        try
        {
            await _preferencesModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private sealed record FocusOption(
        string Value,
        string Title,
        string Description);

}
