@page "/"
@inject Microsoft.Extensions.Localization.IStringLocalizer<FullWorth.Web.Components.App> L

<PageTitle>@L["FullWorth — Understand your bill changes"]</PageTitle>

<div class="landing-page paired-home">
    <section class="hero" id="product">
        <div class="hero-copy">
            <p class="home-kicker">@L["A clearer view of recurring bills"]</p>
            <h1>
                <span class="hero-title hero-title-editorial">
                    @L["Your bills change."]<br />@L["Your understanding should too."]
                </span>
                <span class="hero-title hero-title-workspace">@L["Spot a change. Follow the evidence."]</span>
                <span class="hero-title hero-title-story">
                    <span>@L["From a charge."]</span>
                    <span class="story-accent">@L["To a change."]</span>
                    <span>@L["To a clearer picture."]</span>
                </span>
            </h1>
            <p class="hero-description">@L["Review recurring charges and the evidence behind meaningful changes."]</p>
            <div class="hero-actions">
                <AuthorizeView>
                    <Authorized>
                        <a class="home-primary-action" href="/app">@L["Open FullWorth"]<svg class="bw-sprite" aria-hidden="true"><use href="/assets/billwatch-sprites.svg#arrow-right"></use></svg></a>
                    </Authorized>
                    <NotAuthorized>
                        <a class="home-primary-action" href="/register">@L["Get started"]<svg class="bw-sprite" aria-hidden="true"><use href="/assets/billwatch-sprites.svg#arrow-right"></use></svg></a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </section>

    <div id="inside"><HomeBillExample /></div>

    <section class="home-process" aria-label="@L["How it works"]">
        <ol>
            <li><h2>@L["Connect read-only activity"]</h2><p>@L["Review activity from your connected accounts. Available history and coverage can vary."]</p></li>
            <li><h2>@L["Review supported changes"]</h2><p>@L["Compare recognized bill charges when the amount, currency and history support it."]</p></li>
            <li><h2>@L["Inspect the evidence"]</h2><p>@L["Open available documents and keep unsupported explanations or renewal details unknown."]</p></li>
        </ol>
    </section>

    <section class="home-evidence" id="intelligence">
        <p class="home-kicker">@L["Evidence before explanations"]</p>
        <h2>@L["A transaction shows what you paid."] <span>@L["Available evidence can explain what changed."]</span></h2>
        <p>@L["An increase over past charges does not establish a merchant rate change or its cause. A payment or active access alone does not prove that a subscription will renew. FullWorth keeps these distinctions visible."]</p>
        <AuthorizeView><Authorized><a class="home-text-action" href="/app/bills">@L["Review bills"]<svg class="bw-sprite" aria-hidden="true"><use href="/assets/billwatch-sprites.svg#arrow-right"></use></svg></a></Authorized><NotAuthorized><a class="home-text-action" href="/register">@L["Start with your own records"]<svg class="bw-sprite" aria-hidden="true"><use href="/assets/billwatch-sprites.svg#arrow-right"></use></svg></a></NotAuthorized></AuthorizeView>
    </section>

    <section class="home-security" id="security">
        <div><p class="home-kicker">@L["Designed for financial data"]</p><h2>@L["Visibility without control of your money."]</h2></div>
        <div>
            <p>@L["FullWorth is designed to monitor and explain financial activity, not move money. Private financial records remain behind authenticated, user-scoped access."]</p>
            <p>@L["Your bank credentials are handled by Plaid, not entered into FullWorth."]</p>
            <a class="home-text-action" href="/privacy">@L["Read the Privacy Notice"]<svg class="bw-sprite" aria-hidden="true"><use href="/assets/billwatch-sprites.svg#arrow-right"></use></svg></a>
        </div>
    </section>
</div>
