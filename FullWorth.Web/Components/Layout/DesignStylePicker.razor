@implements IAsyncDisposable
@inject IJSRuntime JS
@inject Microsoft.Extensions.Localization.IStringLocalizer<FullWorth.Web.Components.App> L

<label class="design-picker" title="@L["Saved on this browser"]">
    <span>@L["Style"]</span>
    <select aria-label="@L["Appearance style"]" disabled="@(!_ready)"
            @bind="_selected" @bind:after="ChangeDesignAsync">
        <option value="editorial">@L["Editorial"]</option>
        <option value="workspace">@L["Workspace"]</option>
        <option value="story">@L["Story"]</option>
    </select>
</label>
@if (_unavailable)
{
    <span class="design-picker-error" role="status">@L["Style controls unavailable. Reload to try again."]</span>
}

@code {
    private IJSObjectReference? _module;
    private string _selected = "editorial";
    private bool _ready, _unavailable, _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/design-style.js");
            if (_disposed) { await module.DisposeAsync(); return; }
            _module = module;
            _selected = await module.InvokeAsync<string>("initializeDesignStyle");
            if (_disposed) return;
            _ready = true;
            StateHasChanged();
        }
        catch (JSException)
        {
            if (_disposed) return;
            _unavailable = true;
            StateHasChanged();
        }
    }

    private async Task ChangeDesignAsync()
    {
        if (!_ready || _module is null || _disposed) return;
        try { _selected = await _module.InvokeAsync<string>("selectDesignStyle", _selected); }
        catch (JSException) { _ready = false; _unavailable = true; }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
