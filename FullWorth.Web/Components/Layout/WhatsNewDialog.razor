@implements IAsyncDisposable
@inject IJSRuntime JS

@if (_isOpen && _notes is not null)
{
    <div class="whats-new-backdrop"
         role="presentation"
         @onclick="DismissAsync">
        <section class="whats-new-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="whats-new-title"
                 aria-describedby="whats-new-summary"
                 @onclick:stopPropagation="true"
                 @onkeydown="HandleKeyDownAsync"
                 tabindex="-1">

            <div class="whats-new-glow" aria-hidden="true"></div>

            <div class="whats-new-header">
                <div class="whats-new-icon" aria-hidden="true">
                    <svg class="bw-sprite">
                        <use href="/assets/billwatch-sprites.svg#scan"></use>
                    </svg>
                </div>

                <div class="whats-new-heading-copy">
                    <span class="whats-new-kicker">What’s new</span>
                    <h2 id="whats-new-title">@_notes.Title</h2>
                    <p id="whats-new-summary">@_notes.Summary</p>
                </div>

                <button type="button"
                        class="whats-new-close"
                        aria-label="Close What’s new"
                        @onclick="DismissAsync">
                    <span aria-hidden="true">×</span>
                </button>
            </div>

            <div class="whats-new-grid">
                @foreach (var highlight in _notes.Highlights)
                {
                    <article class="whats-new-item">
                        <span class="whats-new-item-icon" aria-hidden="true">
                            <svg class="bw-sprite">
                                <use href="@GetSpriteHref(highlight.Icon)"></use>
                            </svg>
                        </span>
                        <div class="whats-new-item-copy">
                            <h3>@highlight.Title</h3>
                            <p>@highlight.Description</p>
                        </div>
                    </article>
                }
            </div>

            <div class="whats-new-footer">
                <span class="whats-new-release">@_notes.Version</span>
                <button type="button"
                        class="whats-new-primary"
                        @onclick="DismissAsync">
                    Explore FullWorth
                    <svg class="bw-sprite" aria-hidden="true">
                        <use href="/assets/billwatch-sprites.svg#chevron-left"></use>
                    </svg>
                </button>
            </div>
        </section>
    </div>
}

@code {
    private IJSObjectReference? _module;
    private DotNetObjectReference<WhatsNewDialog>? _callback;
    private ReleaseNotes? _notes;
    private bool _isOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./js/whats-new.js");
            _callback = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("start", _callback);
        }
        catch (JSDisconnectedException)
        {
            // Navigation/reconnection during initialization is harmless.
        }
        catch (JSException)
        {
            // Release notes never block the authenticated application.
        }
    }

    [JSInvokable]
    public Task OnNotesAvailable(ReleaseNotes notes) => InvokeAsync(() =>
    {
        if (!IsValid(notes)) return;
        _notes = notes;
        _isOpen = true;
        StateHasChanged();
    });

    private async Task DismissAsync()
    {
        if (_notes is null) return;

        _isOpen = false;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("acknowledge", _notes.Id);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
                // The dialog still dismisses when storage is blocked.
            }
        }
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
            await DismissAsync();
    }

    private static bool IsValid(ReleaseNotes? notes) =>
        notes is not null &&
        notes.Id.Length is >= 4 and <= 80 &&
        notes.Id.All(character => char.IsAsciiLetterOrDigit(character) || character is '.' or '_' or '-') &&
        notes.Title.Length is > 0 and <= 110 &&
        notes.Summary.Length is > 0 and <= 400 &&
        notes.Version.Length is > 0 and <= 90 &&
        notes.Highlights is { Count: >= 1 and <= 6 } &&
        notes.Highlights.All(highlight =>
            highlight.Title.Length is > 0 and <= 110 &&
            highlight.Description.Length is > 0 and <= 450 &&
            highlight.Icon is "scan" or "trend-up" or "shield" or "check");

    private static string GetSpriteHref(string icon) =>
        $"/assets/billwatch-sprites.svg#{icon}";

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stop");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
                // Browser circuit may already be gone.
            }
        }
        _callback?.Dispose();
    }

    public sealed class ReleaseNotes
    {
        public string Id { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string Summary { get; set; } = string.Empty;
        public string Version { get; set; } = string.Empty;
        public List<ReleaseHighlight> Highlights { get; set; } = [];
    }

    public sealed class ReleaseHighlight
    {
        public string Icon { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
}
