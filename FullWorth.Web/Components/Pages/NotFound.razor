@page "/not-found"
@inject Microsoft.Extensions.Localization.IStringLocalizer<FullWorth.Web.Components.App> L
@layout MainLayout

<PageTitle>@L["Page not found — FullWorth"]</PageTitle>

<div class="system-page">
    <section class="system-card" aria-labelledby="not-found-title">
        <div class="system-icon" aria-hidden="true">404</div>
        <span class="system-kicker">FullWorth</span>
        <h1 id="not-found-title">@L["We couldn't find that page."]</h1>
        <p>
            @L["The link may be outdated, or the page may have moved. Your FullWorth data has not been changed."]
        </p>

        <div class="system-actions">
            <a class="system-primary-action" href="/app">@L["Go to FullWorth"]</a>
            <a class="system-secondary-action" href="/">@L["Back to home"]</a>
        </div>
    </section>
</div>
