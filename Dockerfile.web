FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:0d99ebf1ccad15037b5c98c9fe8979d6b8dbac23812feae2277a0b277b5c5ffa AS build

WORKDIR /src

COPY FullWorth.Core/FullWorth.Core.csproj FullWorth.Core/
COPY FullWorth.Web/FullWorth.Web.csproj FullWorth.Web/
RUN dotnet restore FullWorth.Web/FullWorth.Web.csproj

COPY FullWorth.Core/ FullWorth.Core/
COPY FullWorth.Web/ FullWorth.Web/

RUN dotnet publish FullWorth.Web/FullWorth.Web.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0@sha256:d5633778c754e89a386882eddf8dbee6942447a8a4b8267c19cf1e1158d0b0ac AS final

ARG BILLWATCH_RELEASE_ID=unknown

LABEL org.opencontainers.image.revision="$BILLWATCH_RELEASE_ID"

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /app/publish/ ./
COPY deploy/application-entrypoint.sh /usr/local/bin/fullworth-application-entrypoint

RUN mkdir --parents /var/lib/billwatch-web/keys \
    && chown --recursive "$APP_UID:$APP_UID" /var/lib/billwatch-web \
    && chmod 0700 /var/lib/billwatch-web/keys

ENV ASPNETCORE_HTTP_PORTS=8080 \
    DOTNET_EnableDiagnostics=0

EXPOSE 8080

USER $APP_UID

HEALTHCHECK --interval=30s --timeout=8s --start-period=30s --retries=3 \
    CMD curl --fail --silent --header "Host: $AllowedHosts" http://localhost:8080/health/ready || exit 1

ENTRYPOINT ["sh", "/usr/local/bin/fullworth-application-entrypoint"]
CMD ["dotnet", "FullWorth.Web.dll"]