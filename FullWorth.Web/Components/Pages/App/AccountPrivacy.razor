@page "/app/account/privacy"

@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@layout AppLayout

@implements IAsyncDisposable

@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<AccountPrivacy> L

<PageTitle>@L["Data & Privacy — FullWorth"]</PageTitle>

<link rel="stylesheet" href="/account-privacy.css" />

<div class="app-page privacy-page" aria-busy="@(IsBusy ? "true" : "false")">
    <a class="privacy-back-link fw-back-link" href="/app/account">
        <svg class="bw-sprite" aria-hidden="true">
            <use href="/assets/billwatch-sprites.svg#chevron-left"></use>
        </svg>
        @L["Account"]
    </a>

    <header class="page-heading">
        <div>
            <span class="page-kicker">@L["Data ownership"]</span>
            <h1>@L["Data & privacy"]</h1>
            <p>@L["See what FullWorth keeps, take a portable copy of your data, or permanently remove your account."]</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_message) && !_showExportConfirmation && !_showDeleteConfirmation)
    {
        <div class="@GetMessageClass()" role="@(_messageSucceeded ? "status" : "alert")" aria-live="polite">
            @_message
        </div>
    }

    <section class="fw-privacy-hero">
        <div class="fw-privacy-hero-copy">
            <div class="fw-privacy-hero-icon" aria-hidden="true">
                <svg class="bw-sprite">
                    <use href="/assets/billwatch-sprites.svg#shield"></use>
                </svg>
            </div>

            <div>
                <span class="page-kicker">@L["Your data stays under your control"]</span>
                <h2>@L["Financial visibility without financial control."]</h2>
                <p>@L["FullWorth uses your connected financial data to discover recurring bills and explain supported changes. It does not move money or expose protected provider tokens to the client."]</p>
            </div>
        </div>

        <div class="fw-privacy-trust-grid">
            <div>
                <span>@L["Ownership"]</span>
                <strong>@L["User-scoped"]</strong>
                <small>@L["Financial records stay scoped to your account"]</small>
            </div>

            <div>
                <span>@L["Bank credentials"]</span>
                <strong>@L["Not stored"]</strong>
                <small>@L["Plaid handles bank sign-in credentials"]</small>
            </div>

            <div>
                <span>@L["Money movement"]</span>
                <strong>@L["None"]</strong>
                <small>@L["FullWorth does not transfer or pay money"]</small>
            </div>
        </div>
    </section>

    <section class="fw-privacy-control-grid">
        <article class="privacy-management-card fw-privacy-export-card">
            <div class="privacy-management-icon" aria-hidden="true">
                <svg class="bw-sprite">
                    <use href="/assets/billwatch-sprites.svg#document"></use>
                </svg>
            </div>

            <div class="privacy-management-copy">
                <span class="panel-kicker">@L["Portable data"]</span>
                <h2>@L["Export your FullWorth data"]</h2>
                <p>@L["Download a JSON copy of the financial records FullWorth stores for your account."]</p>

                <div class="privacy-facts">
                    <span>✓ @L["Bank connections and masked accounts"]</span>
                    <span>✓ @L["Transactions, Bill Streams and alerts"]</span>
                    <span>✓ @L["Statement metadata and extracted bill history"]</span>
                    <span>✓ @L["No protected Plaid access tokens"]</span>
                    <span>✓ @L["No internal statement storage paths"]</span>
                    <span>✓ @L["Metadata only—not original statement files"]</span>
                </div>
            </div>

            @if (!_showExportConfirmation)
            {
                <button type="button"
                        class="privacy-primary-button"
                        disabled="@IsBusy"
                        @onclick="ShowExportConfirmation">
                    @L["Download data"]
                </button>
            }
            else
            {
                <div class="export-confirmation" role="group" aria-labelledby="export-confirmation-heading">
                    <strong id="export-confirmation-heading">@L["Confirm this sensitive export"]</strong>
                    <p>@L["Re-enter your current credentials before FullWorth prepares a copy of your financial data."]</p>
                    <p>@L["The JSON copy is not encrypted. Save it privately and delete any shared copies when you no longer need them."]</p>

                    <label>
                        <span>@L["Current password"]</span>
                        <input class="export-confirmation-input"
                                   type="password"
                                   autocomplete="current-password"
                                   disabled="@IsBusy"
                                   @bind="_exportCurrentPassword" @bind:event="oninput" />
                    </label>

                    <label>
                        <span>@L["Authenticator code (if two-factor authentication is enabled)"]</span>
                        <input class="export-confirmation-input"
                                   inputmode="numeric"
                                   autocomplete="one-time-code"
                                   disabled="@IsBusy"
                                   @bind="_exportTwoFactorCode" @bind:event="oninput" />
                    </label>

                    <div class="export-confirmation-actions">
                        <button type="button"
                                class="privacy-secondary-button"
                                disabled="@IsBusy"
                                @onclick="CancelExport">
                            @L["Cancel"]
                        </button>

                        <button type="button"
                                class="privacy-primary-button"
                                disabled="@(!CanExport)"
                                @onclick="ExportDataAsync">
                            @(_isExporting ? L["Preparing export…"] : L["Download securely"])
                        </button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_message))
                    {
                        <div class="@GetMessageClass()" role="alert">@_message</div>
                    }
                </div>
            }
        </article>

        <article class="privacy-explanation-card fw-privacy-explanation">
            <div>
                <span class="panel-kicker">@L["Why FullWorth keeps data"]</span>
                <h2>@L["Evidence is what makes explanations trustworthy."]</h2>
            </div>

            <p>@L["Transactions are used to discover recurring bills. Statements and extracted line items provide evidence for what changed and why. Alerts surface meaningful findings. FullWorth does not use this data to move money."]</p>
        </article>
    </section>

    <section class="danger-zone fw-privacy-danger">
        <div class="danger-zone-heading">
            <div class="danger-icon">!</div>

            <div>
                <span class="danger-kicker">@L["Danger zone"]</span>
                <h2>@L["Permanently delete FullWorth"]</h2>
            </div>
        </div>

        <p>@L["Account deletion attempts to revoke active bank connections first. If FullWorth cannot safely revoke one of them, deletion stops rather than claiming your account was removed."]</p>

        <div class="delete-consequences">
            <strong>@L["Permanent deletion removes:"]</strong>
            <span>@L["Financial connections and account records"]</span>
            <span>@L["Imported bank transactions"]</span>
            <span>@L["Bill Streams, statements, line items and changes"]</span>
            <span>@L["FullWorth alerts and stored statement files"]</span>
            <span>@L["Subscription entitlements and program memberships"]</span>
            <span>@L["Your FullWorth Identity account"]</span>
        </div>

        @if (!_showDeleteConfirmation)
        {
            <button type="button"
                    class="danger-button"
                    disabled="@IsBusy"
                    @onclick="ShowDeleteConfirmation">
                @L["Delete account permanently"]
            </button>
        }
        else
        {
            <div class="delete-confirmation" role="group" aria-labelledby="delete-confirmation-heading">
                <strong id="delete-confirmation-heading">@L["This cannot be undone."]</strong>
                <p>@L["Re-enter your current credentials, then type DELETE to confirm permanent account deletion."]</p>
                <p>@L["Cancel closes this form. It cannot undo a deletion request already sent."]</p>

                <label>
                    <span>@L["Current password"]</span>
                    <input class="delete-confirmation-input"
                               type="password"
                               autocomplete="current-password"
                               disabled="@IsBusy"
                               @bind="_currentPassword" @bind:event="oninput" />
                </label>

                <label>
                    <span>@L["Authenticator code (if two-factor authentication is enabled)"]</span>
                    <input class="delete-confirmation-input"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               disabled="@IsBusy"
                               @bind="_twoFactorCode" @bind:event="oninput" />
                </label>

                <label>
                    <span>@L["Type DELETE to confirm"]</span>
                    <input class="delete-confirmation-input"
                               autocomplete="off"
                               disabled="@IsBusy"
                               @bind="_deleteConfirmation" @bind:event="oninput" />
                </label>

                <div class="delete-confirmation-actions">
                    <button type="button"
                            class="cancel-delete-button"
                            disabled="@IsBusy"
                            @onclick="CancelDelete">
                        @L["Cancel"]
                    </button>

                    <button type="button"
                            class="final-delete-button"
                            disabled="@(!CanDelete)"
                            @onclick="DeleteAccountAsync">
                        @(_isDeleting ? L["Deleting securely…"] : L["Delete permanently"])
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <div class="@GetMessageClass()" role="alert">@_message</div>
                }
            </div>
        }
    </section>
</div>

@code {
    private IJSObjectReference? _bffModule;
    private IJSObjectReference? _deleteModule;
    private bool _isExporting;
    private bool _isDeleting;
    private bool _showExportConfirmation;
    private bool _showDeleteConfirmation;
    private bool _messageSucceeded;
    private string _exportCurrentPassword = string.Empty;
    private string _exportTwoFactorCode = string.Empty;
    private string _deleteConfirmation = string.Empty;
    private string _currentPassword = string.Empty;
    private string _twoFactorCode = string.Empty;
    private string? _message;

    private bool _disposed;
    private long _operationVersion;
    private bool IsBusy => _isExporting || _isDeleting;
    private bool CanExport =>
        !_disposed && _showExportConfirmation && !IsBusy &&
        !string.IsNullOrWhiteSpace(
            _exportCurrentPassword);

    private bool CanDelete =>
        !_disposed && _showDeleteConfirmation && !IsBusy &&
        !string.IsNullOrWhiteSpace(_currentPassword) &&
        string.Equals(
            _deleteConfirmation,
            "DELETE",
            StringComparison.Ordinal);

    private async Task<IJSObjectReference> GetBffModuleAsync()
    {
        _bffModule ??= await ImportPrivacyModuleAsync("./js/account-export.js");

        return _bffModule;
    }

    private async Task<IJSObjectReference> GetDeleteModuleAsync()
    {
        _deleteModule ??= await ImportPrivacyModuleAsync("./js/account-delete.js");

        return _deleteModule;
    }

    private async Task<IJSObjectReference> ImportPrivacyModuleAsync(string path)
    {
        var module = await JS.InvokeAsync<IJSObjectReference>("import", path);
        if (_disposed)
        {
            await module.DisposeAsync();
            throw new ObjectDisposedException(nameof(AccountPrivacy));
        }
        return module;
    }

    private void ShowExportConfirmation()
    {
        if (_disposed || IsBusy)
        {
            return;
        }

        _showDeleteConfirmation = false;
        ClearDeletionCredentials();
        _showExportConfirmation = true;
        ClearExportCredentials();
        _message = null;
    }

    private void CancelExport()
    {
        if (_disposed || IsBusy)
        {
            return;
        }

        _showExportConfirmation = false;
        ClearExportCredentials();
        _message = null;
    }

    private async Task ExportDataAsync()
    {
        if (!CanExport) return;
        var version = ++_operationVersion;
        _isExporting = true;
        _message = null;
        try
        {
            var module = await GetBffModuleAsync();
            if (_disposed || version != _operationVersion) return;
            var requested = await module.InvokeAsync<bool>("downloadAccountExport",
                _exportCurrentPassword, _exportTwoFactorCode);
            if (_disposed || version != _operationVersion) return;
            if (!requested) throw new InvalidOperationException("Download was not requested.");
            _showExportConfirmation = false;
            _messageSucceeded = true;
            _message = L["Download requested. Check Files or Downloads to confirm the JSON copy was saved. Keep it private."];
        }
        catch (JSException exception)
        {
            if (!_disposed && version == _operationVersion)
            {
                _messageSucceeded = false;
                _message = GetSafeExportErrorMessage(exception);
            }
        }
        catch (Exception)
        {
            if (!_disposed && version == _operationVersion)
            {
                _messageSucceeded = false;
                _message = L["FullWorth could not prepare your data export."];
            }
        }
        finally
        {
            ClearExportCredentials();
            if (version == _operationVersion) _isExporting = false;
        }
    }

    private void ShowDeleteConfirmation()
    {
        if (_disposed || IsBusy)
        {
            return;
        }

        _showExportConfirmation = false;
        ClearExportCredentials();
        _showDeleteConfirmation = true;
        ClearDeletionCredentials();
        _message = null;
    }

    private void CancelDelete()
    {
        if (_disposed || IsBusy)
        {
            return;
        }

        _showDeleteConfirmation = false;
        ClearDeletionCredentials();
        _message = null;
    }

    private async Task DeleteAccountAsync()
    {
        if (!CanDelete) return;
        var version = ++_operationVersion;
        _isDeleting = true;
        _message = null;
        try
        {
            var module = await GetDeleteModuleAsync();
            if (_disposed || version != _operationVersion) return;
            var confirmed = await module.InvokeAsync<bool>("deleteFullWorthAccount",
                _deleteConfirmation, _currentPassword, _twoFactorCode);
            if (_disposed || version != _operationVersion) return;
            if (!confirmed) throw new InvalidOperationException("Deletion was not confirmed.");
            ClearDeletionCredentials();
            Navigation.NavigateTo("/?accountDeleted=1", forceLoad: true);
        }
        catch (JSException exception)
        {
            if (!_disposed && version == _operationVersion)
            {
                _messageSucceeded = false;
                _message = GetSafeErrorMessage(exception);
            }
        }
        catch (Exception)
        {
            if (!_disposed && version == _operationVersion)
            {
                _messageSucceeded = false;
                _message = L["We could not confirm the deletion result. Your account may or may not have been deleted. Check sign-in before deciding to retry."];
            }
        }
        finally
        {
            // Never retain reauthentication material after either a rejected or uncertain result.
            ClearDeletionCredentials();
            if (version == _operationVersion) _isDeleting = false;
        }
    }

    private void ClearExportCredentials()
    {
        _exportCurrentPassword = string.Empty;
        _exportTwoFactorCode = string.Empty;
    }

    private void ClearDeletionCredentials()
    {
        _deleteConfirmation = string.Empty;
        _currentPassword = string.Empty;
        _twoFactorCode = string.Empty;
    }

    private string GetMessageClass()
    {
        return _messageSucceeded
            ? "privacy-message success"
            : "privacy-message error";
    }

    private string GetSafeExportErrorMessage(
        JSException exception)
    {
        var common = GetCommonPrivacyError(exception.Message);
        if (common is not null) return common;
        var message = exception.Message?
            .Split(
                '\n',
                StringSplitOptions.RemoveEmptyEntries)
            .FirstOrDefault()?
            .Trim();

        if (string.IsNullOrWhiteSpace(message))
        {
            return L["FullWorth could not prepare your data export."];
        }

        if (message.Contains(
                "Current password is incorrect",
                StringComparison.OrdinalIgnoreCase))
        {
            return L["Your current password is incorrect."];
        }

        if (message.Contains(
                "authenticator code",
                StringComparison.OrdinalIgnoreCase))
        {
            return L["Enter a valid current authenticator code to export your data."];
        }

        return L["FullWorth could not prepare your data export."];
    }

    private string GetSafeErrorMessage(JSException exception)
    {
        var common = GetCommonPrivacyError(exception.Message);
        if (common is not null) return common;
        var message = exception.Message?
            .Split(
                '\n',
                StringSplitOptions.RemoveEmptyEntries)
            .FirstOrDefault()?
            .Trim();

        if (string.IsNullOrWhiteSpace(message))
        {
            return L["We could not confirm the deletion result. Your account may or may not have been deleted. Check sign-in before deciding to retry."];
        }

        if (message.Contains(
                "Current password is incorrect",
                StringComparison.OrdinalIgnoreCase))
        {
            return L["Your current password is incorrect."];
        }

        if (message.Contains(
                "authenticator code",
                StringComparison.OrdinalIgnoreCase))
        {
            return L["Enter a valid current authenticator code to delete this account."];
        }

        if (message.Contains(
                "staff accounts cannot be self-deleted",
                StringComparison.OrdinalIgnoreCase))
        {
            return L["Staff roles must be removed through the authorized admin workflow before this account can be deleted."];
        }

        if (message.Contains(
                "bank connection could not be revoked",
                StringComparison.OrdinalIgnoreCase))
        {
            return L["FullWorth could not safely revoke a connected bank, so your account was not deleted. Try again shortly."];
        }

        if (message.Contains(
                "stored statement",
                StringComparison.OrdinalIgnoreCase))
        {
            return L["FullWorth could not securely remove all stored statement files, so your account was not deleted."];
        }

        return L["We could not confirm the deletion result. Your account may or may not have been deleted. Check sign-in before deciding to retry."];
    }

    private string? GetCommonPrivacyError(string? message)
    {
        if (message?.Contains("Too many attempts", StringComparison.OrdinalIgnoreCase) == true)
            return L["Too many attempts. Wait before trying again; no request will be retried automatically."];
        if (message?.Contains("session expired", StringComparison.OrdinalIgnoreCase) == true)
            return L["Your session expired. Sign in again before making another privacy request."];
        return null;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _operationVersion++;
        ClearExportCredentials();
        ClearDeletionCredentials();
        _message = null;
        _showExportConfirmation = false;
        _showDeleteConfirmation = false;
        if (_bffModule is not null)
        {
            try { await _bffModule.InvokeVoidAsync("cancelAccountExport"); }
            catch (JSException) { }
            try { await _bffModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }

        if (_deleteModule is not null)
        {
            try
            {
                await _deleteModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
