@inherits LayoutComponentBase

@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<FullWorth.Web.Components.App> L

@if (UseStandaloneLegalLayout)
{
    <link rel="stylesheet"
          href="/theme.css" />

    <div class="legal-standalone-layout">
        @Body

        <div class="legal-theme-control">
            <ThemeToggle />
        </div>
    </div>
}
else
{
    <link rel="stylesheet"
          href="/theme.css" />

    <link rel="stylesheet"
          href="/premium-public.css" />

    <div class="site-shell @(IsHomePage ? "home-site-shell" : "")">
        <header class="site-header">
            <div class="header-inner">
                <a class="brand"
                   href="/"
                   aria-label="@L["FullWorth home"]">

                    <img class="brand-mark" src="/assets/fullworth/fullworth-mark.svg" width="44" height="44" alt="" />

                    <span class="brand-name">
                        FullWorth
                    </span>
                </a>

                <nav class="desktop-nav"
                     aria-label="@L["Primary navigation"]">
                    <a class="product-nav" href="/#product">@L["The product"]</a>

                    <a href="/#inside">
                        @L["How it works"]
                    </a>

                    <a href="/#intelligence">
                        @L["Evidence"]
                    </a>

                    <a href="/#security">
                        @L["Security"]
                    </a>
                </nav>

                <div class="header-actions">
                    <DesignStylePicker />
                    <ThemeToggle />

                    <AuthorizeView>
                        <Authorized>
                            <a class="header-action"
                               href="/app">
                                @L["Dashboard"]
                            </a>
                        </Authorized>

                        <NotAuthorized>
                            <a class="header-action"
                               href="/login">
                                @L["Sign in"]
                            </a>

                            <a class="header-action"
                               href="/register">
                                @L["Get started"]
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </header>

        <main>
            @Body
        </main>

        <footer class="site-footer">
            <div class="footer-inner">
                <div class="footer-brand">
                    <a class="brand"
                       href="/"
                       aria-label="@L["FullWorth home"]">

                        <img class="brand-mark brand-mark-small" src="/assets/fullworth/fullworth-mark.svg" width="32" height="32" alt="" />

                        <span class="brand-name">
                            FullWorth
                        </span>
                    </a>

                    <p>
                        @L["Review bill changes and available evidence."]
                    </p>
                </div>

                <div class="footer-status">
                    <span class="status-dot"></span>

                    <span>
                        @L["Built around privacy, clarity, and evidence."]
                    </span>
                </div>

                <nav class="footer-legal-links" aria-label="@L["Legal information"]"><a href="/terms">@L["Terms"]</a><a href="/privacy">@L["Privacy Notice"]</a></nav>

                <div class="footer-copy">
                    © @DateTime.UtcNow.Year FullWorth
                </div>
            </div>
        </footer>
    </div>
}

@code {
    private bool IsHomePage => new Uri(Navigation.Uri).AbsolutePath == "/";
    private bool UseStandaloneLegalLayout
    {
        get
        {
            var path = new Uri(
                    Navigation.Uri)
                .AbsolutePath;

            return path.Equals(
                       "/terms",
                       StringComparison.OrdinalIgnoreCase) ||
                   path.Equals(
                       "/privacy",
                       StringComparison.OrdinalIgnoreCase);
        }
    }
}
